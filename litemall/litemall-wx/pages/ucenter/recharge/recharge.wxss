.page {
  min-height: 100vh;
  background: #f6f2ec;
  padding: 24rpx 24rpx 220rpx;
}

.header {
  background: linear-gradient(135deg, #3d2b1f 0%, #6b4f35 100%);
  border-radius: 20rpx;
  padding: 36rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.header-label {
  font-size: 23rpx;
  color: rgba(247, 239, 226, 0.72);
}

.header-num {
  margin-top: 12rpx;
  font-size: 62rpx;
  font-weight: 600;
  color: #f3dcae;
  line-height: 1.1;
}

.block {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
}

.block-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #3d2b1f;
  margin-bottom: 22rpx;
}

.plans {
  display: flex;
  flex-wrap: wrap;
}

.plan {
  width: calc(33.33% - 14rpx);
  margin: 0 10rpx 16rpx 0;
  border: 2rpx solid #efe6da;
  border-radius: 16rpx;
  padding: 22rpx 8rpx;
  text-align: center;
  background: #fdfbf7;
}

.plan-on {
  border-color: #d99a3f;
  background: #fdf4e4;
}

.plan-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.plan-gift {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #d99a3f;
}

.plan-points {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9b8c7c;
}

.custom {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #efe6da;
  padding-bottom: 16rpx;
}

.custom-symbol {
  font-size: 38rpx;
  color: #3d2b1f;
  margin-right: 14rpx;
}

.custom-input {
  flex: 1;
  font-size: 34rpx;
  color: #3d2b1f;
}

.custom-tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #b3a596;
}

.summary-bar {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}

.summary-line {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 25rpx;
  color: #6b5b4b;
}

.summary-amount {
  color: #d99a3f;
  font-weight: 600;
}

.summary-gift {
  color: #4a7c59;
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(61, 43, 31, 0.06);
}

.pay-btn {
  background: linear-gradient(135deg, #e09a2d, #e8bb6f);
  color: #3d2b1f;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.pay-btn::after {
  border: none;
}

.pay-btn-disabled {
  opacity: 0.6;
}

.pay-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b3a596;
}
